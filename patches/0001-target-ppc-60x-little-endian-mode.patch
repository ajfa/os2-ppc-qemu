+/* Access size of a load/store, for the ones a 60x can take misaligned */
+static unsigned ppc_ldst_size(uint32_t insn)
+{
+    unsigned op = insn >> 26, xo = (insn >> 1) & 0x3ff;
+
+    switch (op) {
+    case 32 ... 33: case 36 ... 37: case 46 ... 49: case 52 ... 53:
+        return 4;
+    case 34 ... 35: case 38 ... 39:
+        return 1;
+    case 40 ... 45:
+        return 2;
+    case 50 ... 51: case 54 ... 55:
+        return 8;
+    case 31:
+        switch (xo) {
+        case 279: case 311: case 343: case 375: case 407: case 439:
+        case 790: case 918:
+            return 2;
+        case 599: case 631: case 727: case 759:
+            return 8;
+        case 87: case 119: case 215: case 247:
+            return 1;
+        default:
+            return 4;
+        }
+    }
+    return 4;
+}
+
+/*
+ * DSISR for an alignment interrupt as the 60x reports it: the bits that
+ * identify the instruction in 15-21, then rS/rD and rA.
+ */
+static uint32_t ppc_align_dsisr(uint32_t insn)
+{
+    uint32_t d = (insn & 0x03FF0000) >> 16;
+
+    if ((insn >> 26) == 31) {
+        d |= ((insn >> 1) & 3) << 15;           /* insn bits 29:30 */
+        d |= ((insn >> 6) & 1) << 14;           /* insn bit 25 */
+        d |= ((insn >> 7) & 0xf) << 10;         /* insn bits 21:24 */
+    } else {
+        d |= ((insn >> 26) & 1) << 14;          /* insn bit 5 */
+        d |= ((insn >> 27) & 0xf) << 10;        /* insn bits 1:4 */
+    }
+    return d;
+}
