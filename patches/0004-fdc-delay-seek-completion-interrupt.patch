+/*
+ * A real drive needs milliseconds to step the head, and drivers written for
+ * it (the IBM OS/2 PowerPC floppy driver) only wait for the seek interrupt
+ * after issuing the command.  Complete the movement now, interrupt later.
+ */
+static void fdctrl_seek_done(void *opaque)
+{
+    FDCtrl *fdctrl = opaque;
+
+    fdctrl->status0 |= FD_SR0_SEEK;
+    fdctrl_raise_irq(fdctrl);
+}
+
+static void fdctrl_seek_start(FDCtrl *fdctrl)
+{
+    timer_mod(fdctrl->seek_timer,
+              qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 5 * SCALE_MS);
+}
