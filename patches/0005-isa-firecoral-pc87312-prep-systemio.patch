+/*
+ * IBM 27-82xxx "Fire Coral": the Carolina's PCI-ISA bridge, an SIO work-alike
+ * with IBM additions reached through an index (BAR0+0) / data (BAR0+4) pair.
+ */
+static uint64_t firecoral_read(void *opaque, hwaddr addr, unsigned size)
+{
+    I82378State *s = opaque;
+    uint64_t val = 0;
+    unsigned i;
+
+    if (addr < 4) {
+        val = s->coral_index >> (8 * addr);
+    } else {
+        for (i = 0; i < size; i++) {
+            val |= (uint64_t)s->coral_regs[(s->coral_index + addr - 4 + i) & 0xff]
+                   << (8 * i);
+        }
+    }
+    qemu_log_mask(LOG_UNIMP, "firecoral: read  %s idx %02x/%u = %" PRIx64 "\n",
+                  addr < 4 ? "index" : "data ", s->coral_index & 0xff, size, val);
+    return val;
+}
+
+static void firecoral_write(void *opaque, hwaddr addr, uint64_t val,
+                            unsigned size)
+{
+    I82378State *s = opaque;
+    unsigned i;
+
+    if (addr < 4) {
+        s->coral_index = val;
+        return;
+    }
+    qemu_log_mask(LOG_UNIMP, "firecoral: write idx %02x/%u = %" PRIx64 "\n",
+                  s->coral_index & 0xff, size, val);
+    for (i = 0; i < size; i++) {
+        s->coral_regs[(s->coral_index + addr - 4 + i) & 0xff] = val >> (8 * i);
+    }
+}
+
+static const MemoryRegionOps firecoral_ops = {
+    .read = firecoral_read,
+    .write = firecoral_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .impl.min_access_size = 1,
+    .impl.max_access_size = 4,
+};
+
+static void firecoral_realize(PCIDevice *pci, Error **errp)
+{
+    I82378State *s = I82378(pci);
+
+    i82378_realize(pci, errp);
+    memory_region_init_io(&s->coral_io, OBJECT(s), &firecoral_ops, s,
+                          "firecoral", 8);
+    pci_register_bar(pci, 0, PCI_BASE_ADDRESS_SPACE_IO, &s->coral_io);
+}
+
+static void firecoral_class_init(ObjectClass *klass, const void *data)
+{
+    PCIDeviceClass *k = PCI_DEVICE_CLASS(klass);
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    k->realize = firecoral_realize;
+    k->vendor_id = PCI_VENDOR_ID_IBM;
+    k->device_id = 0x000a;
+    k->revision = 0x00;
+    dc->desc = "IBM Fire Coral PCI-ISA bridge";
+}
+
+static const TypeInfo firecoral_type_info = {
+    .name = "ibm-firecoral",
+    .parent = TYPE_I82378,
+    .class_init = firecoral_class_init,
+};
+
 static void i82378_register_types(void)
 {
     type_register_static(&i82378_type_info);
+    type_register_static(&firecoral_type_info);
 }
 
 type_init(i82378_register_types)
